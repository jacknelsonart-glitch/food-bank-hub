# Password for staff pages (sorting donations, packing parcels, sign-ups).
# Required in production; staff pages are disabled until it is set.
STAFF_PASSWORD=

# Enables AI photo sorting. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

