# Password for staff pages (sorting donations, packing parcels, sign-ups).
# Required in production; staff pages are disabled until it is set.
STAFF_PASSWORD=

# Set to true to turn the staff password off, e.g. when testing at home.
# Never use this on a public site: anyone could see stock and volunteers' details.
# OPEN_STAFF_PAGES=true

# Enables AI photo sorting. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional settings
# DATABASE_PATH=./data/foodbank.db
# TEST_SITE=true             # show a "this is a test version" banner
# SEED_DEMO=false            # don't add the example food banks
# ANTHROPIC_MODEL=claude-opus-5-5
# OPEN_FOOD_FACTS_USER_AGENT="YourFoodBank/1.0 (you@example.org)"
